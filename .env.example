# =====================================================================
# HH Performance — instancia Neura ERP monocliente
# Copiar a `.env.local` y completar. NUNCA versionar el archivo con valores.
# =====================================================================

# --- Supabase (self-hosted) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Identidad de la instancia ---
# El schema debe existir en PostgreSQL y estar expuesto en PostgREST.
# No apuntar nunca a `public` ni al schema de otro cliente.
APP_DB_SCHEMA=hhperfomance
NEXT_PUBLIC_APP_DB_SCHEMA=hhperfomance
NEURA_CLIENT_SCHEMA=hhperfomance
NEURA_INSTANCE_MODE=single_client
NEURA_CLIENT_NAME=HH Performance
NEXT_PUBLIC_NEURA_CLIENT_NAME=HH Performance

# --- Facturación electrónica (SIFEN) ---
# Cifra la contraseña del certificado .p12 antes de guardarla en la base.
# Obligatoria para poder cargar el certificado: sin ella el guardado de la
# contraseña falla con error 500 y no se persiste nada.
#
# Generar con:  openssl rand -base64 48
# Mínimo 16 caracteres. Definirla ANTES de cargar la contraseña del .p12 y
# NO cambiarla nunca: es la que descifra lo ya guardado. Si cambia, hay que
# volver a cargar la contraseña del certificado a mano.
SIFEN_SECRETS_KEY=
